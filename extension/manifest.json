{
  "manifest_version": 3,
  "name": "Medallas para Wikipedia",
  "version": "1.0.5",
  "description": "Inserta medallas en los editores de Wikipedia en español.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Insertar medalla",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/medal-16.png",
      "32": "icons/medal-32.png"
    }
  },
  "icons": {
    "16": "icons/medal-16.png",
    "32": "icons/medal-32.png",
    "48": "icons/medal-48.png",
    "128": "icons/medal-128.png"
  }
}
